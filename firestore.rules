rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Helpers ---
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email']) &&
             data.uid == request.auth.uid &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() <= 150 &&
             (data.get('privacyConsent', true) is bool) &&
             (data.get('consentDate', request.time) is timestamp);
    }

    function isValidSafetyPlan(data) {
      return data.keys().hasAll(['userId']) &&
             data.userId == request.auth.uid &&
             (data.get('triggers', '') is string && data.get('triggers', '').size() <= 2000) &&
             (data.get('internalCoping', '') is string && data.get('internalCoping', '').size() <= 2000);
    }

    function isValidSafetyPlanLog(data) {
      return data.userId == request.auth.uid &&
             data.type is string &&
             data.note is string &&
             data.note.size() <= 2000;
    }

    function isValidThoughtRecord(data) {
      return data.keys().hasAll(['userId', 'situation', 'thoughts']) &&
             data.userId == request.auth.uid &&
             data.situation is string && data.situation.size() <= 1000 &&
             data.thoughts is string && data.thoughts.size() <= 2000;
    }

    function isValidMoodLog(data) {
      return data.keys().hasAll(['userId', 'mood', 'emotionType']) &&
             data.userId == request.auth.uid &&
             data.mood is number && data.mood >= 1 && data.mood <= 10 &&
             data.emotionType is string && data.emotionType.size() <= 100 &&
             (data.get('note', '') is string && data.get('note', '').size() <= 1000) &&
             (data.get('createdAt', request.time) is timestamp);
    }

    function isValidReminder(data) {
      return data.keys().hasAll(['userId', 'title', 'type', 'time', 'days', 'enabled']) &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 100 &&
             data.type in ['mood', 'goal', 'meditation', 'custom'] &&
             data.time is string && data.time.matches('^([01]?[0-9]|2[0-3]):[0-5][0-9]$') &&
             data.days is list && data.days.size() <= 7 &&
             data.enabled is bool;
    }

    // --- Collection Matches ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasAny(['displayName', 'email', 'emergencyContact', 'lastLoginAt', 'privacyConsent', 'consentDate']);
    }

    match /users/{userId}/safetyPlans/{planId} {
      allow list, get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidSafetyPlan(incoming());
      allow update: if isOwner(userId) && isValidSafetyPlan(incoming());
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/safetyPlanLogs/{logId} {
      allow list, get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidSafetyPlanLog(incoming());
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/thoughtRecords/{recordId} {
      allow list, get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidThoughtRecord(incoming());
      allow update: if isOwner(userId) && isValidThoughtRecord(incoming());
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/moodLogs/{logId} {
      allow list, get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidMoodLog(incoming());
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/reminders/{reminderId} {
      allow list, get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidReminder(incoming());
      allow update: if isOwner(userId) && isValidReminder(incoming());
      allow delete: if isOwner(userId);
    }
  }
}
