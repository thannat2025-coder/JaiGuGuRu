{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User account information and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "privacyConsent": { "type": "boolean" },
        "consentDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" },
        "emergencyContact": { "type": "string" }
      },
      "required": ["uid", "displayName", "email"]
    },
    "SafetyPlan": {
      "title": "My Safety Net",
      "description": "Personalized safety plan for high-risk moments",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "triggers": { "type": "string" },
        "internalCoping": { "type": "string" },
        "distractions": { "type": "string" },
        "trustedContacts": { "type": "array" },
        "professionalHelp": { "type": "array" },
        "environmentSafety": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId"]
    },
    "ThoughtRecord": {
      "title": "CBT Thought Record",
      "description": "Interactive diary for tracking thoughts, emotions, and behaviors",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "situation": { "type": "string" },
        "thoughts": { "type": "string" },
        "emotions": { "type": "string" },
        "distortionTypes": { "type": "array" },
        "rationalResponse": { "type": "string" },
        "outcome": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "situation", "thoughts"]
    },
    "MoodLog": {
      "title": "Mood and Emotion Log",
      "description": "Tracking user emotions and intensity over time",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "mood": { "type": "number", "description": "Intensity rating 1-10" },
        "emotionType": { "type": "string", "description": "Type of emotion (e.g. Happy, Sad, Anxious)" },
        "note": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "mood", "emotionType"]
    },
    "Reminder": {
      "title": "Reminder",
      "description": "User notification preferences",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["mood", "goal", "meditation", "custom"] },
        "time": { "type": "string" },
        "days": { "type": "array", "items": { "type": "string" } },
        "enabled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "type", "time", "days", "enabled"]
    },
    "BehaviorActivation": {
      "title": "Behavioral Activation Activity",
      "description": "Activities scheduled and rated for Pleasure & Mastery to combat depression",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "scheduledTime": { "type": "string" },
        "status": { "type": "string", "enum": ["planned", "completed", "skipped"] },
        "pleasure": { "type": "number", "minimum": 0, "maximum": 10 },
        "mastery": { "type": "number", "minimum": 0, "maximum": 10 },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "status", "pleasure", "mastery"]
    },
    "SafetyPlanLog": {
      "title": "Safety Plan Log",
      "description": "Logs for daily safety confirmations and safety plan updates",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["safe-confirmed", "plan-updated"] },
        "note": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "note"]
    },
    "AppFeedback": {
      "title": "Application Evaluation and Feedback",
      "description": "Evaluations on UI design, CBT features, first-aid tools, privacy, and general comments",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "userName": { "type": "string" },
        "email": { "type": "string" },
        "easeOfUse": { "type": "number" },
        "cbtDojo": { "type": "number" },
        "mentalFirstAid": { "type": "number" },
        "privacyFeeling": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "userName", "email", "easeOfUse", "cbtDojo", "mentalFirstAid", "privacyFeeling", "createdAt"]
    },
    "ResearchDemographic": {
      "title": "Research Demographic and Consent Information",
      "description": "De-identified demographic registration specifically for mental health clinical research purposes",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "consented": { "type": "boolean" },
        "consentDate": { "type": "string", "format": "date-time" },
        "gender": { "type": "string" },
        "age": { "type": "number" },
        "occupation": { "type": "string" },
        "studentYear": { "type": "string" },
        "province": { "type": "string" },
        "medicalIllness": { "type": "string" },
        "psychiatricMedication": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "consented", "gender", "age", "occupation", "province", "createdAt"]
    },
    "ClinicalScreening": {
      "title": "Clinical Mental Health Screening Scores",
      "description": "Tracking patient clinical progression using DASS-21, PHQ-A, and BNSSI-AT scales over 8 checkpoints",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "checkpointIndex": { "type": "number" },
        "checkpointLabel": { "type": "string" },
        "dassDepression": { "type": "number" },
        "dassAnxiety": { "type": "number" },
        "dassStress": { "type": "number" },
        "phqScore": { "type": "number" },
        "hasNsi": { "type": "boolean" },
        "nsiMethods": { "type": "array" },
        "nsiFrequency": { "type": "string" },
        "nsiReasons": { "type": "array" },
        "nsiSeverity": { "type": "number" },
        "rawAnswers": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "checkpointIndex", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Individual user profiles"
    },
    "/users/{userId}/researchDemographics/{docId}": {
      "schema": "ResearchDemographic",
      "description": "Research clinical demographics and consent details"
    },
    "/users/{userId}/screeningHistory/{screeningId}": {
      "schema": "ClinicalScreening",
      "description": "Patient progress tracker of clinical evaluations across 8 periodic check-ins"
    },
    "/users/{userId}/reminders/{reminderId}": {
      "schema": "Reminder",
      "description": "Custom reminders for the user"
    },
    "/users/{userId}/safetyPlans/{planId}": {
      "schema": "SafetyPlan",
      "description": "User personal safety plans"
    },
    "/users/{userId}/safetyPlanLogs/{logId}": {
      "schema": "SafetyPlanLog",
      "description": "User daily safety check and update logs"
    },
    "/users/{userId}/thoughtRecords/{recordId}": {
      "schema": "ThoughtRecord",
      "description": "CBT Diary entries"
    },
    "/users/{userId}/moodLogs/{logId}": {
      "schema": "MoodLog",
      "description": "Stress and mood logs"
    },
    "/users/{userId}/behaviorActivation/{baId}": {
      "schema": "BehaviorActivation",
      "description": "User behavioral activation logs including scheduled items, pleasure and mastery ratings"
    },
    "/appFeedback/{feedbackId}": {
      "schema": "AppFeedback",
      "description": "User satisfaction evaluations shared with the clinical creator"
    }
  }
}
